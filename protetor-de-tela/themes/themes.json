{
  "themes": [
    {
      "id": "vanta-birds",
      "name": "Pássaros (Vanta)",
      "description": "Bando de pássaros em 3D que reage ao mouse, feito com Vanta.js e three.js (MIT). Cores, quantidade e comportamento ajustáveis.",
      "path": "themes/vanta-birds/index.html",
      "options": [
        {
          "key": "backgroundColor",
          "label": "Cor do fundo",
          "type": "color",
          "default": "#07192f"
        },
        {
          "key": "color1",
          "label": "Cor 1 dos pássaros",
          "type": "color",
          "default": "#ff0000"
        },
        {
          "key": "color2",
          "label": "Cor 2 dos pássaros",
          "type": "color",
          "default": "#00d1ff"
        },
        {
          "key": "colorMode",
          "label": "Modo de cor",
          "type": "select",
          "default": "varianceGradient",
          "choices": [
            {
              "value": "lerp",
              "label": "Mistura"
            },
            {
              "value": "variance",
              "label": "Variação"
            },
            {
              "value": "lerpGradient",
              "label": "Mistura com degradê"
            },
            {
              "value": "varianceGradient",
              "label": "Variação com degradê"
            }
          ]
        },
        {
          "key": "quantity",
          "label": "Quantidade",
          "type": "range",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "key": "birdSize",
          "label": "Tamanho dos pássaros",
          "type": "range",
          "min": 0.5,
          "max": 3,
          "step": 0.1,
          "default": 1
        },
        {
          "key": "wingSpan",
          "label": "Abertura das asas",
          "type": "range",
          "min": 10,
          "max": 40,
          "step": 1,
          "default": 30
        },
        {
          "key": "speedLimit",
          "label": "Velocidade máxima",
          "type": "range",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 5
        },
        {
          "key": "separation",
          "label": "Separação",
          "type": "range",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 20
        },
        {
          "key": "alignment",
          "label": "Alinhamento",
          "type": "range",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 20
        },
        {
          "key": "cohesion",
          "label": "Coesão",
          "type": "range",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 20
        },
        {
          "key": "wakeOnClick",
          "label": "Fechar também com clique",
          "type": "checkbox",
          "default": false
        }
      ]
    },
    {
      "id": "vanta-waves",
      "name": "Ondas (Vanta)",
