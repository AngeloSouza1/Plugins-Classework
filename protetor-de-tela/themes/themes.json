        {
          "key": "waveSpeed",
          "label": "Velocidade das ondas",
          "type": "range",
          "min": 0,
          "max": 5,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "zoom",
          "label": "Zoom",
          "type": "range",
          "min": 0.5,
          "max": 2,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "wakeOnClick",
          "label": "Fechar também com clique",
          "type": "checkbox",
          "default": false
        }
      ]
    },
    {
      "id": "rex",
